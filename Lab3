// Варіант 2:
// Body -> Parallelepiped, Ball
// ===============================

abstract class Body {
    public abstract double surfaceArea();

    public abstract double volume();

    public abstract void Show();
}

// Паралелепіпед
class Parallelepiped extends Body {
    private double a;
    private double b;
    private double c;

    public Parallelepiped(double a, double b, double c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    @Override
    public double surfaceArea() {
        return 2 * (a * b + a * c + b * c);
    }

    @Override
    public double volume() {
        return a * b * c;
    }

    @Override
    public void Show() {
        System.out.println("Паралелепіпед:");
        System.out.println("a = " + a);
        System.out.println("b = " + b);
        System.out.println("c = " + c);
        System.out.println("Площа поверхні = " + surfaceArea());
        System.out.println("Об'єм = " + volume());
    }

    @Override
    public String toString() {
        return "Parallelepiped{" +
                "a=" + a +
                ", b=" + b +
                ", c=" + c +
                '}';
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }

        if (!(obj instanceof Parallelepiped)) {
            return false;
        }

        Parallelepiped other = (Parallelepiped) obj;

        return a == other.a &&
                b == other.b &&
                c == other.c;
    }
}

// Куля
class Ball extends Body {
    private double radius;

    public Ball(double radius) {
        this.radius = radius;
    }

    @Override
    public double surfaceArea() {
        return 4 * Math.PI * radius * radius;
    }

    @Override
    public double volume() {
        return (4.0 / 3.0) * Math.PI * radius * radius * radius;
    }

    @Override
    public void Show() {
        System.out.println("Куля:");
        System.out.println("Радіус = " + radius);
        System.out.println("Площа поверхні = " + surfaceArea());
        System.out.println("Об'єм = " + volume());
    }

    @Override
    public String toString() {
        return "Ball{" +
                "radius=" + radius +
                '}';
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }

        if (!(obj instanceof Ball)) {
            return false;
        }

        Ball other = (Ball) obj;

        return radius == other.radius;
    }
}


// ===============================
// ЗАВДАННЯ 3
// Body замінено інтерфейсом
// ===============================

interface BodyInterface {
    double surfaceArea();

    double volume();

    void Show();
}

// Паралелепіпед через інтерфейс
class ParallelepipedInterface implements BodyInterface {
    private double a;
    private double b;
    private double c;

    public ParallelepipedInterface(double a, double b, double c) {
        this.a = a;
        this.b = b;
        this.c = c;
    }

    @Override
    public double surfaceArea() {
        return 2 * (a * b + a * c + b * c);
    }

    @Override
    public double volume() {
        return a * b * c;
    }

    @Override
    public void Show() {
        System.out.println("Паралелепіпед через інтерфейс:");
        System.out.println("Площа поверхні = " + surfaceArea());
        System.out.println("Об'єм = " + volume());
    }

    @Override
    public String toString() {
        return "ParallelepipedInterface{" +
                "a=" + a +
                ", b=" + b +
                ", c=" + c +
                '}';
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }

        if (!(obj instanceof ParallelepipedInterface)) {
            return false;
        }

        ParallelepipedInterface other =
                (ParallelepipedInterface) obj;

        return a == other.a &&
                b == other.b &&
                c == other.c;
    }
}

// Куля через інтерфейс
class BallInterface implements BodyInterface {
    private double radius;

    public BallInterface(double radius) {
        this.radius = radius;
    }

    @Override
    public double surfaceArea() {
        return 4 * Math.PI * radius * radius;
    }

    @Override
    public double volume() {
        return (4.0 / 3.0) * Math.PI *
                radius * radius * radius;
    }

    @Override
    public void Show() {
        System.out.println("Куля через інтерфейс:");
        System.out.println("Площа поверхні = " + surfaceArea());
        System.out.println("Об'єм = " + volume());
    }

    @Override
    public String toString() {
        return "BallInterface{" +
                "radius=" + radius +
                '}';
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) {
            return true;
        }

        if (!(obj instanceof BallInterface)) {
            return false;
        }

        BallInterface other = (BallInterface) obj;

        return radius == other.radius;
    }
}


